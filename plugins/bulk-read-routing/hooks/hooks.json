{
  "description": "Block recognizable full-file reads above the configured line threshold.",
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --no-project --managed-python --python 3.11 python \"$PLUGIN_ROOT/scripts/pre_tool_use.py\"",
            "timeout": 5,
            "statusMessage": "Checking bulk read size"
          }
        ]
      }
    ]
  }
}
